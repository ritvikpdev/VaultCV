{
  "name": "vaultcv",
  "version": "0.1.0",
  "private": true,
  "description": "Resume tuner: a vault of everything you've done, many tailored resumes. Next.js + Supabase.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "npm run db:generate --silent && node --experimental-strip-types --test \"tests/**/*.test.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:export": "node scripts/db-export.mjs",
    "db:sync": "node scripts/db-export.mjs data/exports/vaultcv-sync.db --force",
    "db:import": "node scripts/db-import.mjs",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "vault:import-sqlite": "node --env-file-if-exists=.env.local scripts/import-sqlite-vault.mjs",
    "db:sql": "node scripts/schema-sql.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-bold": "3.31.4",
    "@tiptap/extension-document": "3.31.4",
    "@tiptap/extension-italic": "3.31.4",
    "@tiptap/extension-link": "3.31.4",
    "@tiptap/extension-text": "3.31.4",
    "@tiptap/extension-text-align": "3.31.4",
    "@tiptap/extension-underline": "3.31.4",
    "@tiptap/extensions": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.2",
    "lucide-react": "^0.469.0",
    "next": "^15.5.4",
    "pdf-parse": "1.1.4",
    "postgres": "^3.4.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.15.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3"
  }
}
