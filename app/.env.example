# Copy to .env.local and fill in what you have. .env.local is gitignored.

# Where the SQLite database lives, relative to the app directory.
DATABASE_PATH=./data/vaultcv.db

# ---------------------------------------------------------------------------
# AI is entirely optional.
#
# Vault editing, resume building, customization, PDF export, JD parsing and
# matching against your vault ALL work with nothing set here. The deterministic
# parser is the primary path, not a fallback. A provider only improves how
# cleanly a job description is broken into requirements, and unlocks bullet
# rewriting.
#
# Set at most one. If several are present the first available wins, in the
# order below. Force a choice with AI_PROVIDER=anthropic|gemini|ollama.
# ---------------------------------------------------------------------------

# AI_PROVIDER=

# Option 1 — Anthropic. Best quality. Paid, fractions of a cent per run.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Option 2 — Google Gemini. Has a free tier that comfortably covers personal use.
# Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Option 3 — a model on your own machine via Ollama. Free, no account, fully
# offline. Quality depends heavily on model size; a small model will often do
# worse than the built-in deterministic parser, so compare before committing.
#   ollama pull llama3.1
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1
