# Copy to .env.local and fill in. .env.local is gitignored. On Vercel, set the
# same names under Project → Settings → Environment Variables.

# ---------------------------------------------------------------------------
# Supabase — all from your project dashboard.
# ---------------------------------------------------------------------------

# Project URL (Project Settings → Data API, or the home page).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Project Settings → API Keys. The publishable key ("sb_publishable_…", or the
# legacy "anon" key) is safe in the browser — row-level security is what
# protects the data. The secret key ("sb_secret_…", or legacy "service_role")
# bypasses RLS and must never reach the browser; only the admin page uses it.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Connect → Connection string.
#   DATABASE_URL           — "Transaction pooler", port 6543. What the app uses.
#   MIGRATION_DATABASE_URL — "Session pooler", port 5432. What `db:push` uses;
#                            schema introspection doesn't work through the
#                            transaction pooler.
# Replace [YOUR-PASSWORD] with the database password you chose.
DATABASE_URL=
MIGRATION_DATABASE_URL=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------

# The one account that sees /admin and can invite people. Case-insensitive.
ADMIN_EMAIL=

# Public URL of the app, used to build invite and reset links.
# Locally: http://localhost:3000. On Vercel: your https://….vercel.app URL.
SITE_URL=http://localhost:3000

# Encrypts each user's AI key before it is stored. Any long random string;
# generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it later makes saved keys unreadable — users would re-enter them.
VAULTCV_SECRET=

# ---------------------------------------------------------------------------
# AI is entirely optional — and per user.
#
# Each person adds their own Anthropic or Gemini key in Settings. Vault editing,
# resume building, customization, PDF export, JD parsing and matching ALL work
# with no key. These only choose which model a saved key talks to.
# ---------------------------------------------------------------------------

ANTHROPIC_MODEL=claude-sonnet-5
GEMINI_MODEL=gemini-3.5-flash

# Server-level option for local development: a model on your own machine via
# Ollama, used for anyone without a key of their own. Leave unset on Vercel.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1
